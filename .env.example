# ========================================================
# EducTrack — Configuración de Variables de Entorno
# ========================================================

# ── Servidor ──
PORT=3000
NODE_ENV=development
JWT_SECRET=eductrack_jwt_secreto_super_seguro_2026

# ========================================================
# OPCIÓN A: Conexión con TiDB Cloud (Serverless / Dedicated)
# ========================================================
# Obtén estos datos en: https://tidbcloud.com -> Tu Cluster -> "Connect"
# TiDB Cloud siempre utiliza el puerto 4000 y requiere SSL.

DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=xxxxxx.root
DB_PASSWORD=tu_password_de_tidb_aqui
DB_NAME=eductrack_db
DB_SSL=true

# O si prefieres usar la Connection String completa de TiDB Cloud:
# DATABASE_URL=mysql://usuario:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/eductrack_db?ssl={"rejectUnauthorized":true}

# ========================================================
# OPCIÓN B: Conexión Local con MySQL / XAMPP / MariaDB
# ========================================================
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=eductrack_db
# DB_SSL=false
